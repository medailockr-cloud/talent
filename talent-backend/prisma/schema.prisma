generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String?
  avatarUrl String?
  videos      Video[]
  likes       Like[]
  comments    Comment[]
  ratings     Rating[]
  createdAt   DateTime @default(now())
}

model Video {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  url         String
  
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id])
  
  likes       Like[]
  comments    Comment[]
  ratings     Rating[]
  
  createdAt   DateTime  @default(now())
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  videoId   Int
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  userId    Int
  videoId   Int
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])
  createdAt DateTime @default(now())
}

model Rating {
  id        Int      @id @default(autoincrement())
  score     Int
  userId    Int
  videoId   Int
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}
