generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("USER") // USER, ADMIN
  name      String?
  bio       String?
  avatarUrl String?
  pushToken String?
  isPrivate Boolean  @default(false)
  videos      Video[]
  likes       Like[]
  comments    Comment[]
  ratings     Rating[]
  followers   Follows[] @relation("following")
  following   Follows[] @relation("follower")
  notifications Notification[] @relation("userNotifications")
  sentNotifications Notification[] @relation("actorNotifications")
  reports     Report[]
  savedVideos SavedVideo[]
  sentMessages Message[] @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")
  blockedUsers Block[] @relation("blocker")
  blockedBy   Block[] @relation("blocked")
  watchHistory WatchHistory[]
  liveStream  LiveStream?
  createdAt   DateTime @default(now())
}

model Video {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  url         String
  
  category     String?
  subCategory  String?
  purpose      String?
  location     String?
  allowJudging Boolean   @default(true)
  isDraft      Boolean   @default(false)
  privacy      String    @default("PUBLIC") // PUBLIC, PRIVATE, FRIENDS
  
  views       Int       @default(0)
  shares      Int       @default(0)
  hashtags    Hashtag[]
  
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id])
  
  likes       Like[]
  comments    Comment[]
  ratings     Rating[]
  notifications Notification[]
  reports     Report[]
  savedBy     SavedVideo[]
  watchHistory WatchHistory[]
  
  createdAt   DateTime  @default(now())
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  videoId   Int
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  userId    Int
  videoId   Int
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])
  createdAt DateTime @default(now())
}

model Rating {
  id        Int      @id @default(autoincrement())
  score     Int
  userId    Int
  videoId   Int
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}

model Follows {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  follower    User     @relation("follower", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Notification {
  id          Int      @id @default(autoincrement())
  type        String   // 'LIKE', 'COMMENT', 'FOLLOW'
  isRead      Boolean  @default(false)
  
  userId      Int      // The user receiving the notification
  user        User     @relation("userNotifications", fields: [userId], references: [id])
  
  actorId     Int?     // The user who performed the action
  actor       User?    @relation("actorNotifications", fields: [actorId], references: [id])
  
  videoId     Int?     // The video the action happened on (if applicable)
  video       Video?   @relation(fields: [videoId], references: [id])
  
  createdAt   DateTime @default(now())
}

model Hashtag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  videos    Video[]
  createdAt DateTime @default(now())
}

model Report {
  id        Int      @id @default(autoincrement())
  reason    String
  status    String   @default("PENDING") // PENDING, REVIEWED, RESOLVED
  
  reporterId Int
  reporter   User    @relation(fields: [reporterId], references: [id])
  
  videoId   Int
  video     Video    @relation(fields: [videoId], references: [id])
  
  createdAt DateTime @default(now())
}

model Message {
  id          Int      @id @default(autoincrement())
  text        String
  
  senderId    Int
  sender      User     @relation("sentMessages", fields: [senderId], references: [id])
  
  receiverId  Int
  receiver    User     @relation("receivedMessages", fields: [receiverId], references: [id])
  
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model LiveStream {
  id          Int      @id @default(autoincrement())
  title       String
  streamKey   String   @unique
  isActive    Boolean  @default(false)
  viewerCount Int      @default(0)
  
  hostId      Int      @unique
  host        User     @relation(fields: [hostId], references: [id])
  
  startedAt   DateTime?
  endedAt     DateTime?
}

model SavedVideo {
  id        Int      @id @default(autoincrement())
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  videoId   Int
  video     Video    @relation(fields: [videoId], references: [id])
  
  createdAt DateTime @default(now())
  
  @@unique([userId, videoId])
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  blocker   User     @relation("blocker", fields: [blockerId], references: [id])
  blocked   User     @relation("blocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model WatchHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  videoId   Int
  watchTime Float    // seconds watched
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])
  createdAt DateTime @default(now())
}
